# Copy to .env.local for local development. Without these, the directory shows example listings only.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Supabase → Project Settings → API Keys → "Publishable key" (older projects: the "anon" key).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
# Your public site address, used in password-reset links. No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Do not add the Supabase "secret"/"service_role" key for normal use. It bypasses row-level security.
# OPTIONAL daily source checks only (server-side, never NEXT_PUBLIC_). See README section 4:
# CRON_SECRET=
# SUPABASE_SECRET_KEY=
