# Copy to .env.local for local development. Without these, the directory shows example listings only.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Supabase → Project Settings → API Keys → "Publishable key" (older projects: the "anon" key).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
# Your public site address, used in password-reset links. No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Never add the Supabase "secret" or "service_role" key to this app. It is not needed, and it bypasses row-level security.
